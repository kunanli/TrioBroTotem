class_name SceneryPlan
extends RefCounted

## 關卡裝飾的資料表。**這個檔案只有資料，沒有邏輯**——產生器在 scenery.gd。
##
## 分成兩個檔案的理由跟 MotionClips／MotionForge 一樣（TD-12）：想調關卡長相的
## 時候要能只看數字，不必先讀懂建網格的程式。改這裡的數字，跑
## `python3 tools/shoot_level.py` 就看得到結果。
##
## ## 什麼東西寫在這裡，什麼寫在 .tscn
##
## **有碰撞、或有任何程式用名字／路徑／群組指到它 → 寫在 `.tscn`。其餘寫在這裡。**
##
## 所以地面、牆的碰撞、藤蔓牆、樹樁、終點台、出生點、觸發區、道具、敵人、燈
## 都還在場景檔裡；路面、邊石、谷壁、草帽、遠山、垂藤這些純裝飾在這裡。
## 這是因為裝飾有 700 個以上的 primitive，手寫那麼多 `[node]` 還要維持
## `load_steps` 精確，錯一次就是 CI 紅。

## 每一關的亂數種子。
##
## **一定要用 RandomNumberGenerator 實例配固定種子，不能用全域 randf()**——
## 全域那個用時間當種子，三台機器會長出三片不一樣的谷壁。裝飾雖然沒有機制
## 作用，但 docs/PLAYTEST.md 明確要測試者互相看對方的螢幕，世界長得不一樣
## 會讓那個比對失去意義。
const SEEDS := {&"arena": 20260831, &"camp": 20260901}

## 路面的中心線。每一段是 `{"p": 位置, "w": 半寬}`，中間會被平滑成曲線。
##
## ## 為什麼路要蜿蜒
##
## 可走寬度（x −6.5…6.5）是碰撞，一格都不能動（docs/07 的尺寸是從實測的移動
## 能力反推的）。但**視覺的路是裝飾，可以自由蜿蜒**——地板保持全平的同時讓路
## 彎，正是「路看起來像路」又不動到謎題的作法。
##
## ## 路要瞄準每一拍
##
## 路在藤蔓牆前收窄（一條明顯收窄、通進被堵死的縫的路，本身就是那個教學）、
## 在斷崖兩側各切一個乾淨的斷面（兩個切口隔著 7 公尺互相對望，是最強的
## 「橋要架在這裡」）、在終點前散開包住平台南面。
const PATHS := {
	&"arena": [
		# 主線。z 從 27 走到崖唇 −4.2 為止。
		[
			{"p": Vector3(0.0, 0.0, 27.0), "w": 3.4},
			{"p": Vector3(0.0, 0.0, 21.0), "w": 3.2},
			{"p": Vector3(1.6, 0.0, 16.5), "w": 3.0},
			{"p": Vector3(1.4, 0.0, 13.0), "w": 2.6},
			{"p": Vector3(0.0, 0.0, 10.2), "w": 2.0},  # 藤蔓牆的缺口是 x −2…2
			{"p": Vector3(0.0, 0.0, 8.2), "w": 1.9},
			{"p": Vector3(0.9, 0.0, 5.5), "w": 2.6},
			{"p": Vector3(0.4, 0.0, 1.5), "w": 2.8},
			{"p": Vector3(0.0, 0.0, -4.2), "w": 2.6},  # 崖唇，乾淨切斷
		],
		# 對岸。**同樣的 x、同樣的寬度**接回去，兩個斷面才會互相對望。
		[
			{"p": Vector3(0.0, 0.0, -10.8), "w": 2.6},
			{"p": Vector3(-0.3, 0.0, -14.0), "w": 3.0},
			{"p": Vector3(0.0, 0.0, -16.8), "w": 4.0},  # 終點台南面在 z = −16.5
		],
		# 往東岔到木箱那一區。道具在**路邊**才像可以撿的東西，不像散落的垃圾。
		[
			{"p": Vector3(1.9, 0.0, 16.8), "w": 1.2},
			{"p": Vector3(4.2, 0.0, 17.6), "w": 1.0},
		],
		# 往西岔到樹樁腳邊，戛然而止。「路到這裡沒了——抬頭看」。
		[
			{"p": Vector3(0.7, 0.0, 3.6), "w": 1.1},
			{"p": Vector3(-0.7, 0.0, 3.2), "w": 0.9},
		],
	],
	&"camp": [
		# 火堆外圍踩出來的環（內徑 2.2、外徑 5.2）。環就是閉合的折線，同一個產生器。
		# **踩出來的地面是人活動留下的實體痕跡**，這一項才是把 1,156 平方公尺的
		# 空地變成營地的那一項。
		[
			{"p": Vector3(3.7, 0.0, 0.0), "w": 1.5},
			{"p": Vector3(2.62, 0.0, 2.62), "w": 1.5},
			{"p": Vector3(0.0, 0.0, 3.7), "w": 1.5},
			{"p": Vector3(-2.62, 0.0, 2.62), "w": 1.5},
			{"p": Vector3(-3.7, 0.0, 0.0), "w": 1.5},
			{"p": Vector3(-2.62, 0.0, -2.62), "w": 1.5},
			{"p": Vector3(0.0, 0.0, -3.7), "w": 1.5},
			{"p": Vector3(2.62, 0.0, -2.62), "w": 1.5},
			{"p": Vector3(3.7, 0.0, 0.0), "w": 1.5},
		],
		# 出生點（z = +6）走進火堆。
		[
			{"p": Vector3(0.0, 0.0, 8.4), "w": 1.9},
			{"p": Vector3(0.0, 0.0, 5.45), "w": 1.7},
		],
		# 火堆往北到看板、再到大門。出生點面向 −z，所以這一條就是「出口在哪」。
		[
			{"p": Vector3(0.0, 0.0, -5.45), "w": 1.8},
			{"p": Vector3(0.0, 0.0, -9.2), "w": 2.2},
			{"p": Vector3(0.4, 0.0, -13.0), "w": 2.0},
			{"p": Vector3(0.0, 0.0, -16.2), "w": 2.4},
		],
	],
}

## 環與岔路之間留的縫。
##
## 兩片共面的薄片重疊就是 z-fighting，而且會閃。留 0.25 公尺的縫，畫面上讀起來
## 就是一般的路口磨損，不會有人覺得哪裡怪。
const PATH_JOIN_GAP := 0.25

## 三頂帳篷的方位（度）。**全部面向火堆**。
##
## 朝向共同中心的物件讀作聚落，排成格子的物件讀作倉庫——整個訣竅就這一句。
## 這裡先定好位置，scenery.gd 的岔路要接過去，第四階段的帳篷本體也用同一組。
const TENT_RING_RADIUS := 7.5
const TENT_ANGLES := [20.0, 140.0, 230.0]

## 地面暗塊：讓平滑的路讀起來是刻意的，而不是地板本來就長這樣。
const CLUMPS := {
	&"arena": {"count": 14, "half": Vector2(5.6, 24.0), "centre": Vector3(0.0, 0.0, 0.0)},
	&"camp": {"count": 18, "half": Vector2(14.0, 14.0), "centre": Vector3(0.0, 0.0, 0.0)},
}

## 邊石不放的地方（世界座標的 AABB，只看 x/z）。
##
## 藤蔓框底下、樹樁台上、斷崖裡、終點台底下——這些地方要嘛有東西擋著，
## 要嘛根本沒有地面。
const NO_KERB := {
	&"arena": [
		{"min": Vector2(-7.0, 8.4), "max": Vector2(7.0, 9.6)},  # 藤蔓牆與兩側岩塊
		{"min": Vector2(-6.2, 0.2), "max": Vector2(-0.8, 5.8)},  # 樹樁台
		{"min": Vector2(-7.0, -11.2), "max": Vector2(7.0, -3.8)},  # 斷崖
		{"min": Vector2(-3.8, -23.8), "max": Vector2(3.8, -16.2)},  # 終點台
	],
	&"camp": [
		{"min": Vector2(-2.2, -11.4), "max": Vector2(2.2, -8.0)},  # 看板
		{"min": Vector2(-11.2, 5.8), "max": Vector2(-6.8, 10.2)},  # 練習台階
	],
}

## 谷壁。**全部長在 x = ±6.5 以外**，也就是可走範圍（−6.5…6.5）之外，
## 所以形狀完全自由，動不到任何一個 docs/07 的尺寸。
##
## 場景檔裡那兩片 56 公尺長的牆只留碰撞、mesh 隱藏起來（不刪節點：load_steps 與
## 節點順序都不動，而且留下一個看得懂的線索）。
##
## ## 三個細節扛住大部分效果
##
##  - **前排往內傾 `lean_deg`**：垂直的牆讀作走廊，頂端往內傾的牆讀作谷。
##    這是「這是一個谷」最強的暗示，而它的代價是一個數字。
##  - **頂上壓一層草**：讀成「被切開的草原」而不是「一面灰牆」，正是
##    assets/reference/level-draft.jpg 畫每一片崖壁的方式。
##  - **遠山往霧色混**：空氣透視，讓 56 公尺讀得出來是 56 公尺。
##
## 谷壁**不投影**（cast_shadow 關掉）。8 公尺高的東西在 32° 仰角下投出 12.8 公尺
## 寬的影子，而走廊只有 13 公尺——照實投影的話這條路永遠是一根沒有光的黑管子。
## 崖壁自己該亮該暗還是照法線算，那才是谷地的讀法。
const CLIFFS := {
	&"arena": {
		"z_from": -30.0,
		"z_to": 27.0,
		"step": 2.2,
		"inner_x": 6.5,
		"depth": Vector2(1.6, 3.2),
		"width": Vector2(2.0, 3.4),
		"height": Vector2(9.0, 17.0),
		"base_y": -3.0,
		"lean_deg": 2.5,
		"yaw_deg": 7.0,
		"cap_thickness": 0.5,
		"range_count": 10,
		"range_x": Vector2(20.0, 38.0),
		"range_height": Vector2(11.0, 21.0),
		"range_width": Vector2(12.0, 26.0),
		"vine_count": 40,
		"vine_length": Vector2(2.0, 6.0),
	},
}

## 斷崖：崖壁、崖底、以及底下那層腐化的霧氣。
##
## 本來這裡是**一個通到天空盒的洞**——沒有崖壁、沒有底，往下看只會看到程序天空
## 的下半球。以前沒人抱怨是因為關卡太平、大家根本不會往下看。
const RAVINE := {
	&"arena": {
		"z_min": -11.0,
		"z_max": -4.0,
		"half_x": 7.0,
		"depth": 12.0,
		"slabs": 8,
	},
}

## 橫跨走廊的岩拱。**下緣在 10 公尺**，三層疊高站 3.00 ＋ 跳 4.51 ＋ 角色身高
## 1.7 ≈ 9.2 公尺，所以碰不到、不影響任何謎題。
##
## 它們的用途是把 56 公尺的直管切成有門的段落，並且把天空分成幾塊——
## 「一條筆直、零轉彎、零岔路的管子」是這一關最大的版型問題，而移動尺寸不能改，
## 所以只能從上方解決。
const ARCH_CLEARANCE := 10.0
const ARCHES := {&"arena": [8.0, -14.0]}

## 營地的柵欄。
##
## 場景檔裡那四片 34×3×1 的實心板留碰撞、mesh 隱藏（跟關卡的谷壁同一招）。
## 它們現在是「一道及胸的圍牆」，不是柵欄——沒有柱子、沒有橫桿、沒有縫。
##
## 北面留一個門。**碰撞維持整片實心**，門純粹是視覺的：營地因此有了正面與方向，
## 但沒有人走得進外面的虛空。出生點在 z = +6 面向 −z，所以
## 圖騰 → 看板 → 大門會落在出生的同一條視線上。
const PALISADE := {
	&"camp": {
		"half": 17.0,
		"spacing": 1.0,
		"post": Vector2(0.24, 0.30),
		"height": Vector2(2.6, 3.3),
		"lean_deg": 5.0,
		"yaw_deg": 8.0,
		"rail_y": [1.0, 2.1],
		"gate_z": -17.0,
		"gate_half": 2.2,
		"gate_height": 4.2,
	},
}

## 火塘：一圈石頭 ＋ 幾根交叉的木頭。
##
## 營火本來是一個裸的圓錐，沒有碰撞也不會閃。閃爍是營地裡最大的「這裡活著」的
## 訊號，而它只有四行（見 campfire.gd）。
const FIRE_RING := {
	&"camp": {"stones": 8, "radius": 0.95, "logs": 5, "log_length": 0.95},
}

## 便宜的雜物。營地現在平均每 73 平方公尺才一個物件，空得像倉庫。
##
## 位置是寫死的，不是亂數撒的——雜物要**看起來像有人放的**：柴堆在帳篷旁邊、
## 木桶靠著柵欄、草長在沒人踩的角落。亂數撒出來的是垃圾場。
const CLUTTER := {
	&"camp": {
		"woodpile": [Vector3(-9.5, 0.0, -1.5), Vector3(8.6, 0.0, -6.2)],
		"barrels": [Vector3(-12.0, 0.0, -9.0), Vector3(-11.0, 0.0, -10.4), Vector3(11.5, 0.0, 3.0)],
		"stumps": [Vector3(-2.6, 0.0, 5.2), Vector3(3.4, 0.0, 4.6), Vector3(5.0, 0.0, -3.2)],
		"tufts": 26,
		"tuft_half": Vector2(15.0, 15.0),
	},
}
